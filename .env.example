# Copy this file to `.env` (which is git-ignored) and fill in real values:
#   cp .env.example .env
#
# These are read ONLY by Netlify Functions (server side). They are never
# bundled into the frontend, because none of them start with `VITE_`.
# On Netlify, set the same names under Project configuration → Environment variables.

# ---- Required for real AI edits ----
# Your OpenAI API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# ---- Optional ----
# Which AI provider to use: "openai" (default) or "mock" (free test mode that
# returns your photo unchanged after a few seconds; no API key needed).
# AI_PROVIDER=openai

# OpenAI image model and quality. Higher quality = slower and more expensive.
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# OPENAI_IMAGE_QUALITY=medium

# Cost guards (protect your API bill):
# AI_DAILY_LIMIT=100           # max AI edits per day, whole site
# AI_HOURLY_LIMIT_PER_IP=20    # max AI edits per hour, per visitor
